# Copie para .env e preencha. O arquivo .env NAO vai para o repositorio.

# --- PostgreSQL (perfil "local") ---
DB_URL=jdbc:postgresql://localhost:5432/teamrec
DB_USERNAME=postgres
DB_PASSWORD=troque-esta-senha

# --- Microsservico Python: motor de predicao (FastAPI + PyCaret) ---
PREDICTION_BASE_URL=http://localhost:8000

# --- API do Gemini (usada a partir da Fase 6) ---
GEMINI_API_KEY=

# --- Origens liberadas no CORS (frontend React) ---
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
