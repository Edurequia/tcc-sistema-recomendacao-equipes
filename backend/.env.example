# Copie para .env e preencha. O arquivo .env NAO vai para o repositorio.
# Ele e lido tanto pelo docker compose quanto pelo Spring (spring.config.import).

# --- PostgreSQL (perfil "local", o padrao) ---
# DB_PORT=5433 aponta para o container do docker-compose.yml.
# Para usar um PostgreSQL instalado na maquina, troque para 5432.
DB_NAME=teamrec
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=troque-esta-senha
# Opcional: sobrescreve a URL montada a partir de DB_PORT e DB_NAME.
# DB_URL=jdbc:postgresql://localhost:5433/teamrec

# --- Microsservico Python: motor de predicao (FastAPI + PyCaret) ---
PREDICTION_BASE_URL=http://localhost:8000

# --- API do Gemini (justificativa da equipe) ---
# A integracao fica DESLIGADA enquanto SPRING_AI_MODEL_CHAT nao for
# google-genai: sem ela, POST /api/recomendacoes/{id}/justificativa responde 503
# dizendo o que falta, e o restante da API funciona normalmente.
# Chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# SPRING_AI_MODEL_CHAT=google-genai
# Opcional: gemini-2.5-flash (padrao), gemini-2.5-pro, gemini-2.5-flash-lite
# LLM_MODELO=gemini-2.5-flash

# --- Origens liberadas no CORS (frontend React) ---
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
