  "tamanhoEquipe": 3,
  "horasSemanaisPorIntegrante": 20,
  "papeisRequeridos": [
    { "papel": "BACKEND", "quantidade": 2 },
    { "papel": "QA",      "quantidade": 2 }
  ]
}

