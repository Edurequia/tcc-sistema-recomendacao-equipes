{
  "nome": "Teste Duplicado",
  "email": "duplicado@ufn.edu.br",
  "senioridade": "PLENO",
  "papelPrincipal": "BACKEND",
  "softSkillsScore": 3.50,
  "horasDisponiveis": 40,
  "habilidades": [
    { "habilidadeId": {{idJava}}, "proficiencia": 5 },
    { "habilidadeId": {{idJava}}, "proficiencia": 2 }
  ]
}


### =========================================================================
### PROJETOS
### =========================================================================

### 21. (*) Projeto de criticidade alta, equipe de 4
# @name projeto
POST {{host}}/api/projetos
Content-Type: application/json

{
  "nome": "Portal Acadêmico",
  "descricao": "Reescrita do portal do aluno, com integração ao sistema acadêmico.",
  "criticidade": "ALTA",
  "tamanhoEquipe": 4,
  "horasSemanaisPorIntegrante": 20,
  "dataInicioPrevista": "2026-10-01",
  "dataFimPrevista": "2027-03-31",
  "papeisRequeridos": [
    { "papel": "BACKEND",  "quantidade": 2 },
    { "papel": "FRONTEND", "quantidade": 1 }
  ],
  "habilidadesRequeridas": [
    { "habilidadeId": {{idJava}},   "obrigatoria": true,  "peso": 5 },
    { "habilidadeId": {{idSpring}}, "obrigatoria": true,  "peso": 4 },
    { "habilidadeId": {{idReact}},  "obrigatoria": false, "peso": 3 }
  ]
}

> {%
    client.global.set("idProjeto", response.body.id);
    client.test("uma vaga ficou sem papel fixo", function() {
        client.assert(response.body.vagasDeclaradas === 3);
        client.assert(response.body.vagasSemPapelFixo === 1);
    });
%}

### 22. Projeto completo, com os requisitos
GET {{host}}/api/projetos/{{idProjeto}}

### 23. Listagem paginada
GET {{host}}/api/projetos

### 24. Filtro por criticidade
GET {{host}}/api/projetos?criticidade=ALTA

